# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
/android/.gradle/
/android/local.properties
**/generated_plugin_registrant.*

# Rust — the native core lives in irc-core/
/irc-core/target/
/irc-core/jniLibs/

# Native build output
**/*.so
**/*.a

# Secrets — never commit credentials
*.env
.env.*
local.env

# Dev IRC server — generated config, self-signed certs and account datastore.
# Regenerated by `make dev-server`; the oper password inside is random per run.
/dev/ergo/

# Dart & Flutter DevTools extension state. Generated by the tooling on first
# `flutter test` or `flutter run`; per-machine, and nothing in the build reads it.
/devtools_options.yaml

# Written by `make dev-server`, deleted by `make dev-server-stop`. Describes a
# server that only exists on this machine.
/dev/server.txt
